<Window x:Class="AIUsageChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:AIUsageChecker.Views"
        xmlns:converters="clr-namespace:AIUsageChecker.Converters"
        mc:Ignorable="d" 
        Title="Turtle AI Usage Checker" 
        Icon="assets/app.ico"
        Height="334" Width="498"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="{Binding IsAlwaysOnTop}"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <!-- メインコンテナ -->
    <Grid>
        <!-- 通常表示モード -->
        <Border x:Name="NormalWidgetBorder"
                Background="#161B19" 
                BorderBrush="#253D32" 
                BorderThickness="1.5" 
                CornerRadius="10" 
                Padding="10,8"
                Visibility="{Binding IsDocked, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- タイトルバー & コントロール -->
                    <RowDefinition Height="Auto"/> <!-- カード配置 (ジャストサイズで上下余白を統一) -->
                </Grid.RowDefinitions>

                <!-- 1. タイトルバー -->
                <Grid Grid.Row="0" Margin="0,0,0,8" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent" Cursor="SizeAll">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- タイトル & アイコン -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 亀キャラクターアイコン -->
                        <Border Width="19" Height="19" CornerRadius="9.5" Margin="0,0,6,0" VerticalAlignment="Center"
                                BorderBrush="#10B981" BorderThickness="1" SnapsToDevicePixels="True">
                            <Border.Clip>
                                <EllipseGeometry Center="9.5,9.5" RadiusX="9" RadiusY="9"/>
                            </Border.Clip>
                            <Image Width="19" Height="19" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Source>
                                    <BitmapImage UriSource="assets/icon-images.png" DecodePixelWidth="38" CacheOption="OnLoad"/>
                                </Image.Source>
                            </Image>
                        </Border>
                        <TextBlock Text="Turtle AI Usage Checker" FontWeight="Bold" FontSize="11.5" Foreground="#E5E7EB" VerticalAlignment="Center"/>
                        <TextBlock Text="•" FontSize="10" Foreground="#4B5563" Margin="5,0"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="9.5" Foreground="#9CA3AF" VerticalAlignment="Center" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- 右側操作ボタン群 (更新, ピン留め, サイド表示, 最小化, 閉じる) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 1. 更新ボタン (大切なボタンとして「更新」テキスト入り) -->
                        <Button ToolTip="全ての利用状況とCLI状態を更新" 
                                Padding="6,2" Margin="0,0,4,0"
                                FontSize="10" FontWeight="SemiBold"
                                Background="#1A2722" Foreground="#34D399" 
                                BorderBrush="#24513E" BorderThickness="1"
                                Command="{Binding RefreshAllCommand}"
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" FontSize="9.5" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                <TextBlock Text="更新" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 2. 最前面固定 (ピン留め 📌 - 点灯/消灯で明確に発光・グレー切替) -->
                        <Button ToolTip="最前面表示の切替" 
                                Width="23" Height="22" Margin="0,0,4,0"
                                Command="{Binding ToggleAlwaysOnTopCommand}"
                                Click="PinButton_Click"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBorder" CornerRadius="4" BorderThickness="1" Background="#1A221F" BorderBrush="#2D3834">
                                                    <TextBlock x:Name="pinIcon" Text="📌" FontSize="9.5" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#6B7280"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsAlwaysOnTop}" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#064E3B"/>
                                                        <Setter TargetName="btnBorder" Property="BorderBrush" Value="#10B981"/>
                                                        <Setter TargetName="pinIcon" Property="Foreground" Value="#34D399"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsAlwaysOnTop}" Value="False">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#1A221F"/>
                                                        <Setter TargetName="btnBorder" Property="BorderBrush" Value="#2D3834"/>
                                                        <Setter TargetName="pinIcon" Property="Foreground" Value="#4B5563"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Opacity" Value="0.85"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- 3. サイド表示ボタン (画面端にドック) -->
                        <Button Content="サイド表示" 
                                ToolTip="画面端にコンパクトに折りたたむ（上下ドラッグ可能）" 
                                Padding="7,2" Margin="0,0,4,0"
                                FontSize="10"
                                Background="#1C2723" Foreground="#9CA3AF" 
                                BorderBrush="#2C3E36" BorderThickness="1"
                                Command="{Binding ToggleDockCommand}"
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- 4. 最小化ボタン (－) -->
                        <Button Content="－" 
                                ToolTip="最小化" 
                                Width="22" Height="22" Margin="0,0,3,0"
                                FontSize="11" FontWeight="Bold"
                                Background="#1C2723" Foreground="#9CA3AF" 
                                BorderBrush="#2C3E36" BorderThickness="1"
                                Click="MinimizeButton_Click"
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- 5. 閉じるボタン (✕) -->
                        <Button Content="✕" 
                                ToolTip="閉じる" 
                                Width="22" Height="22"
                                FontSize="10" FontWeight="Bold"
                                Background="#2D1F1F" Foreground="#F87171" 
                                BorderBrush="#4B2A2A" BorderThickness="1"
                                Click="CloseButton_Click"
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 2. 5枚カード配置 (上段3枚、下段2枚を中央揃えで美しくバランス配置) -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="154" Margin="2,2">
                                <views:UsageCardView MouseLeftButtonUp="Card_MouseLeftButtonUp"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 3. 詳細ポップアップ (半透明バックドロップ + モーダルオーバーレイ) -->
                <Grid Grid.Row="0" Grid.RowSpan="2" 
                      Visibility="{Binding IsDetailOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                      Margin="-10,-8">
                    <!-- 背景バックドロップ (外側クリックで閉じる) -->
                    <Border Background="#B00A0D0C" MouseLeftButtonUp="Backdrop_MouseLeftButtonUp"/>

                    <!-- ポップアップ本体 -->
                    <views:DetailPopupView VerticalAlignment="Center" 
                                           HorizontalAlignment="Center"
                                           Margin="12"/>
                </Grid>

                <!-- 4. 起動時ローディングオーバーレイ (初回データ取得中のスプラッシュ演出) -->
                <Grid x:Name="StartupLoadingOverlay"
                      Grid.Row="0" Grid.RowSpan="2" 
                      Margin="-10,-8"
                      Panel.ZIndex="100">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Opacity" Value="1.0"/>
                            <Setter Property="Visibility" Value="Visible"/>
                            <Setter Property="IsHitTestVisible" Value="True"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStartupLoading}" Value="False">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <!-- スッと消えるフェードアウト演出 (0.45秒) -->
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.45">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.45" Value="{x:Static Visibility.Collapsed}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <BooleanAnimationUsingKeyFrames Storyboard.TargetProperty="IsHitTestVisible">
                                                    <DiscreteBooleanKeyFrame KeyTime="0:0:0.0" Value="False"/>
                                                </BooleanAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <!-- 半透明ダーク背景 (本番カードが美しく透けて見える透明度 約48%) -->
                    <Border Background="#7B0B110E" CornerRadius="10"/>

                    <!-- 中央フローティングスプラッシュカード (グラス調エメラルド枠) -->
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#F2151E1A" 
                            BorderBrush="#2B5B46" 
                            BorderThickness="1.5" 
                            CornerRadius="14" 
                            Padding="26,22" 
                            Width="290">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.75" Color="#000000"/>
                        </Border.Effect>

                        <StackPanel HorizontalAlignment="Center">
                            <!-- 亀キャラクターアイコン (優しいパルス/呼吸アニメーション & デコード最適化) -->
                            <Border Width="68" Height="68" CornerRadius="34"
                                    BorderBrush="#10B981" BorderThickness="2"
                                    Background="#101815"
                                    HorizontalAlignment="Center"
                                    SnapsToDevicePixels="True"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="TurtlePulseScale" ScaleX="1.0" ScaleY="1.0"/>
                                </Border.RenderTransform>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetName="TurtlePulseScale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 From="0.97" To="1.03" Duration="0:0:1.1">
                                                    <DoubleAnimation.EasingFunction>
                                                        <SineEase EasingMode="EaseInOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="TurtlePulseScale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 From="0.97" To="1.03" Duration="0:0:1.1">
                                                    <DoubleAnimation.EasingFunction>
                                                        <SineEase EasingMode="EaseInOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <Border.Effect>
                                    <DropShadowEffect Color="#10B981" BlurRadius="18" ShadowDepth="0" Opacity="0.55"/>
                                </Border.Effect>
                                <Border.Clip>
                                    <EllipseGeometry Center="34,34" RadiusX="32" RadiusY="32"/>
                                </Border.Clip>
                                <Image Width="68" Height="68" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Source>
                                        <BitmapImage UriSource="assets/icon-images.png" DecodePixelWidth="136" CacheOption="OnLoad"/>
                                    </Image.Source>
                                </Image>
                            </Border>

                            <!-- アプリ名表示 -->
                            <TextBlock Text="Turtle AI Usage Checker" 
                                       FontSize="15" FontWeight="Bold" 
                                       Foreground="#F9FAFB" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,12,0,4"/>

                            <!-- 日本語取得中メッセージ -->
                            <TextBlock Text="AI利用量を取得中" 
                                       FontSize="11.5" FontWeight="SemiBold" 
                                       Foreground="#34D399" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,2"/>

                            <!-- 英語取得中メッセージ -->
                            <TextBlock Text="Fetching AI usage quotas..." 
                                       FontSize="9" 
                                       Foreground="#9CA3AF" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,12"/>

                            <!-- シルキー・スムーズ・インジケーター (GPU/RenderTransform駆動で一切カクつかず、優雅にゆったりと流れる光彩バー) -->
                            <Border Width="160" Height="3" Background="#142B22" CornerRadius="1.5" SnapsToDevicePixels="True">
                                <Canvas ClipToBounds="True" Width="160" Height="3">
                                    <Border x:Name="IndeterminateGlowBar" Width="75" Height="3" CornerRadius="1.5">
                                        <Border.RenderTransform>
                                            <TranslateTransform X="-75" Y="0"/>
                                        </Border.RenderTransform>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#0010B981" Offset="0.0"/>
                                                <GradientStop Color="#2534D399" Offset="0.2"/>
                                                <GradientStop Color="#7034D399" Offset="0.4"/>
                                                <GradientStop Color="#E634D399" Offset="0.5"/>
                                                <GradientStop Color="#7034D399" Offset="0.6"/>
                                                <GradientStop Color="#2534D399" Offset="0.8"/>
                                                <GradientStop Color="#0010B981" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetName="IndeterminateGlowBar"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                         From="-75" To="160" Duration="0:0:3.8">
                                                            <DoubleAnimation.EasingFunction>
                                                                <SineEase EasingMode="EaseInOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Border.Triggers>
                                    </Border>
                                </Canvas>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- サイド表示モード (画面端の極小バー: 上下ドラッグ移動可能) -->
        <Border x:Name="DockedWidgetBorder"
                Width="42" Height="140"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Background="#161B19" 
                BorderBrush="#10B981" 
                BorderThickness="2" 
                CornerRadius="8,0,0,8" 
                Padding="4"
                Cursor="SizeNS"
                MouseLeftButtonDown="DockedBorder_MouseLeftButtonDown"
                MouseMove="DockedBorder_MouseMove"
                MouseLeftButtonUp="DockedBorder_MouseLeftButtonUp"
                ToolTip="クリックで通常復帰 / 上下ドラッグで移動"
                Visibility="{Binding IsDocked, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5" Color="#000000"/>
            </Border.Effect>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="18" Height="18" CornerRadius="9" Margin="0,0,0,6" HorizontalAlignment="Center"
                        BorderBrush="#10B981" BorderThickness="0.8" SnapsToDevicePixels="True">
                    <Border.Clip>
                        <EllipseGeometry Center="9,9" RadiusX="8.5" RadiusY="8.5"/>
                    </Border.Clip>
                    <Image Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Source>
                            <BitmapImage UriSource="assets/icon-images.png" DecodePixelWidth="36" CacheOption="OnLoad"/>
                        </Image.Source>
                    </Image>
                </Border>
                <TextBlock Text="A" FontSize="11" FontWeight="Bold" Foreground="#F3F4F6" HorizontalAlignment="Center"/>
                <TextBlock Text="I" FontSize="11" FontWeight="Bold" Foreground="#F3F4F6" HorizontalAlignment="Center"/>
                <TextBlock Text="•" FontSize="11" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,2"/>
                <TextBlock Text="U" FontSize="10" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                <TextBlock Text="S" FontSize="10" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                <TextBlock Text="G" FontSize="10" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                <TextBlock Text="⇅" FontSize="10" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,4,0,0" Opacity="0.8"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
