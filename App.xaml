<Application x:Class="AIUsageChecker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AIUsageChecker"
             xmlns:models="clr-namespace:AIUsageChecker.Models"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- 各サービスの印象を色と抽象図形で表したオリジナルアイコン。公式ロゴは使用しない。 -->
        <DataTemplate x:Key="ServiceLogoTemplate">
            <Viewbox Stretch="Uniform">
                <Grid Width="24" Height="24" SnapsToDevicePixels="True">
                    <!-- GPT/Codex: 円形フレームと6弁スパイラルノット（完全一致を避けつつOpenAIの雰囲気を表現） -->
                    <Canvas x:Name="GptLogo" Visibility="Collapsed">
                        <Ellipse Canvas.Left="1.5" Canvas.Top="1.5" Width="21" Height="21"
                                 Stroke="{Binding ThemeAccentColor}" StrokeThickness="1.5"/>
                        <Path Data="M12.00,9.90 L14.90,9.90 A2.85,2.85 0 0,1 17.90,13.20 L15.10,16.60 M13.82,10.95 L15.27,13.46 A2.85,2.85 0 0,1 13.91,17.71 L9.57,16.98 M13.82,13.05 L12.37,15.56 A2.85,2.85 0 0,1 8.01,16.51 L6.47,12.38 M12.00,14.10 L9.10,14.10 A2.85,2.85 0 0,1 6.10,10.80 L8.90,7.40 M10.18,13.05 L8.73,10.54 A2.85,2.85 0 0,1 10.09,6.29 L14.43,7.02 M10.18,10.95 L11.63,8.44 A2.85,2.85 0 0,1 15.99,7.49 L17.53,11.62"
                              Stroke="#F3F4F6" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Canvas>

                    <!-- Gemini / Antigravity: ベースが鮮やかな青で、上端部に緑・黄・赤のグラデーションが広がるアーチアイコン -->
                    <Canvas x:Name="GeminiLogo" Visibility="Collapsed">
                        <!-- ベース層: 全体〜両足に広がる鮮やかな青 -->
                        <Path Data="M1.5,21.5 C4.5,21.5 6.5,2.5 12,2.5 C17.5,2.5 19.5,21.5 22.5,21.5 L17.5,21.5 C15.8,21.5 14.8,10.5 12,10.5 C9.2,10.5 8.2,21.5 6.5,21.5 Z">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                    <GradientStop Color="#2563EB" Offset="0"/>
                                    <GradientStop Color="#3B82F6" Offset="0.45"/>
                                    <GradientStop Color="#60A5FA" Offset="1"/>
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                        <!-- 上層: 上端部を彩る 緑 → 黄 → 橙 → 赤 のグラデーション（下に向かって青へ自然にブレンド） -->
                        <Path Data="M1.5,21.5 C4.5,21.5 6.5,2.5 12,2.5 C17.5,2.5 19.5,21.5 22.5,21.5 L17.5,21.5 C15.8,21.5 14.8,10.5 12,10.5 C9.2,10.5 8.2,21.5 6.5,21.5 Z">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0.2,0" EndPoint="0.8,0">
                                    <GradientStop Color="#10B981" Offset="0.0"/>
                                    <GradientStop Color="#84CC16" Offset="0.25"/>
                                    <GradientStop Color="#EAB308" Offset="0.5"/>
                                    <GradientStop Color="#F97316" Offset="0.75"/>
                                    <GradientStop Color="#EF4444" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Path.Fill>
                            <Path.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#F0000000" Offset="0.05"/>
                                    <GradientStop Color="#B0000000" Offset="0.28"/>
                                    <GradientStop Color="#00000000" Offset="0.55"/>
                                </LinearGradientBrush>
                            </Path.OpacityMask>
                        </Path>
                    </Canvas>

                    <!-- Grok: X (xAI) 公式ロゴ (ソリッド線とアウトライン線が交差する𝕏マーク) -->
                    <Canvas x:Name="GrokLogo" Visibility="Collapsed">
                        <Path Data="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                              Fill="{Binding ThemeAccentColor}">
                            <Path.RenderTransform>
                                <ScaleTransform ScaleX="0.78" ScaleY="0.78" CenterX="12" CenterY="12"/>
                            </Path.RenderTransform>
                        </Path>
                    </Canvas>

                    <!-- Claude: 琥珀色の小さな陽光 -->
                    <Canvas x:Name="ClaudeLogo" Visibility="Collapsed">
                        <Path Data="M12,2 V5 M19,5 L17,7 M22,12 H19 M19,19 L17,17 M12,22 V19 M5,19 L7,17 M2,12 H5 M5,5 L7,7"
                              Stroke="#EAA36B" StrokeThickness="2.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Ellipse Canvas.Left="8" Canvas.Top="8" Width="8" Height="8"
                                 Fill="{Binding ThemeAccentColor}"/>
                    </Canvas>

                    <!-- Copilot: 黒いバッジに輪郭だけの猫顔。特定のキャラクター形状は使わない。 -->
                    <Canvas x:Name="CopilotLogo" Visibility="Collapsed">
                        <Border Canvas.Left="1" Canvas.Top="1" Width="22" Height="22"
                                CornerRadius="6" Background="#0B0D10" BorderBrush="#545962" BorderThickness="1"/>
                        <Path Data="M5,11 L5.5,5.5 L9,8 C11,7 13,7 15,8 L18.5,5.5 L19,11 C20,15 17.5,19 12,19 C6.5,19 4,15 5,11 Z"
                              Fill="#171A1E" Stroke="{Binding ThemeAccentColor}" StrokeThickness="1.3"
                              StrokeLineJoin="Round"/>
                        <Ellipse Canvas.Left="8.2" Canvas.Top="12" Width="2.3" Height="2.5" Fill="#B5A5E3"/>
                        <Ellipse Canvas.Left="13.5" Canvas.Top="12" Width="2.3" Height="2.5" Fill="#B5A5E3"/>
                        <Ellipse Canvas.Left="11.3" Canvas.Top="15" Width="1.5" Height="1.5" Fill="#D8DDE4"/>
                    </Canvas>
                </Grid>
            </Viewbox>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding ServiceType}" Value="{x:Static models:AiServiceType.GPT}">
                    <Setter TargetName="GptLogo" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ServiceType}" Value="{x:Static models:AiServiceType.Gemini}">
                    <Setter TargetName="GeminiLogo" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ServiceType}" Value="{x:Static models:AiServiceType.Grok}">
                    <Setter TargetName="GrokLogo" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ServiceType}" Value="{x:Static models:AiServiceType.Claude}">
                    <Setter TargetName="ClaudeLogo" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ServiceType}" Value="{x:Static models:AiServiceType.Copilot}">
                    <Setter TargetName="CopilotLogo" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- カスタムスクロールバー Thumb (つまみ) スタイル -->
        <Style x:Key="ModernScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Focusable" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="thumbBorder"
                                CornerRadius="3"
                                Background="#3A4D45"
                                BorderBrush="#506E62"
                                BorderThickness="1"
                                Margin="1,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="#10B981"/>
                                <Setter TargetName="thumbBorder" Property="BorderBrush" Value="#34D399"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="#059669"/>
                                <Setter TargetName="thumbBorder" Property="BorderBrush" Value="#10B981"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- アプリ全体共通 縦スクロールバー スタイル -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="#131A17" Width="8">
                                    <Track x:Name="PART_Track" IsDirectionReversed="true">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                          Opacity="0" Focusable="False"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ModernScrollBarThumb}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                          Opacity="0" Focusable="False"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
